---
permalink: "/podcast.xml"
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" 
     xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd" 
     xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <atom:link href="https://afriquedecrypte.netlify.app/podcast.xml" rel="self" type="application/rss+xml" />
    <title>Afrique Décrypte</title>
    <link>https://afriquedecrypte.netlify.app</link>
    <language>fr</language>
    <copyright>&#xA9; 2026 Afrique Décrypte</copyright>
    <description>Média d'analyse géopolitique et économique sans concession sur le continent africain. Réalisme ethno-historique, lois économiques réelles et rhétorique sans langue de bois.</description>
    <itunes:author>Afrique Décrypte</itunes:author>
    <itunes:summary>Média d'analyse géopolitique et économique sans concession sur le continent africain.</itunes:summary>
    <itunes:owner>
      <itunes:name>Afrique Décrypte</itunes:name>
      <itunes:email>contact@afriquedecrypte.com</itunes:email>
    </itunes:owner>
    <itunes:image href="https://afriquedecrypte.netlify.app/logo-afrique-decrypte.png" />
    <itunes:category text="News">
      <itunes:category text="Politics" />
    </itunes:category>
    <itunes:category text="Society &amp; Culture" />
    <itunes:explicit>no</itunes:explicit>

    {% for post in collections.post | reverse %}
      {% if post.data.podcast %}
      <item>
        <title>{{ post.data.title }}</title>
        <link>https://afriquedecrypte.netlify.app{{ post.url }}</link>
        <guid isPermaLink="true">https://afriquedecrypte.netlify.app{{ post.url }}</guid>
        <pubDate>{{ post.date.toUTCString() }}</pubDate>
        <description><![CDATA[{{ post.data.description }}]]></description>
        <enclosure url="https://afriquedecrypte.netlify.app{{ post.data.podcast }}" length="900000" type="audio/mpeg" />
        <itunes:subtitle>{{ post.data.description }}</itunes:subtitle>
        <itunes:summary><![CDATA[{{ post.data.description }} - Retrouvez l'analyse intégrale et les cartes sur https://afriquedecrypte.netlify.app]]></itunes:summary>
        <itunes:author>{{ post.data.author or "Afrique Décrypte" }}</itunes:author>
        {% if post.data.image %}
        <itunes:image href="https://afriquedecrypte.netlify.app{{ post.data.image }}" />
        {% endif %}
      </item>
      {% endif %}
    {% endfor %}
  </channel>
</rss>
