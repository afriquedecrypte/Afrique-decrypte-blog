---
layout: base.njk
---
<article>
    <h2>{{ title }}</h2>
    <p class="date">Publié le {{ page.date.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' }) }}</p>
    {{ content | safe }}
    {% if author %}
        <p class="author">Par {{ author }}</p>
    {% endif %}
</article>
